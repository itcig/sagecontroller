{
  "name": "itcig/sagecontroller",
  "version": "2.0.5",
  "type": "package",
  "license": "MIT",
  "description": "WordPress package to enable a basic controller when using Timber/Twig with Sage 9",
  "homepage": "https://github.com/itcig",
  "authors": [
    {
      "name": "Brad Ash",
      "email": "bash@capinfogroup.com",
      "homepage": "https://github.com/unfrgivn"
    },
    {
      "name": "Hunter Rancourt",
      "email": "hrancourt@capinfogroup.com",
      "homepage": "https://github.com/skwid138"
    }
  ],
  "keywords": [
    "wordpress",
    "sage",
    "roots"
  ],
  "support": {
    "issues": "https://github.com/itcig/sagecontroller/issues"
  },
  "require": {
    "php": ">=5.6.0",
    "composer/installers": "^1.12",
    "symfony/yaml": "^3.2",
    "brain/hierarchy": "^2.3"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "2.*"
  },
  "autoload": {
    "psr-4": {
      "Cig\\Sage\\Controller\\": "src/",
      "Cig\\Sage\\Controller\\Module\\": "src/Module/"
    },
    "files": [
      "controller.php"
    ]
  },
  "scripts": {
    "test": [
      "vendor/bin/phpcs --extensions=php --ignore=vendor/ ."
    ]
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true
    }
  }
}
